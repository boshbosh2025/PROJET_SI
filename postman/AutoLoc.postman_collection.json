{
  "info": {
    "name": "AutoLoc API",
    "description": "Tests CRUD : Agences, Vehicules, Clients. Lancer dans l'ordre. Les ids crees sont stockes dans les variables de collection. Pour l'association Vehicule/Equipement, importer d'abord autoloc_db.sql (equipements 1 a 4).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "agenceId", "value": "1" },
    { "key": "vehiculeId", "value": "1" },
    { "key": "clientId", "value": "1" },
    { "key": "equipementId", "value": "1" }
  ],
  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "POST - Creer agence",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('agenceId', pm.response.json().idAgence);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"AutoLoc Monastir\",\n  \"ville\": \"Monastir\",\n  \"adresse\": \"8 Avenue de la Corniche\",\n  \"telephone\": \"73111222\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/agences", "host": ["{{baseUrl}}"], "path": ["api", "agences"] }
          }
        },
        {
          "name": "GET - Lister agences",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/agences", "host": ["{{baseUrl}}"], "path": ["api", "agences"] } }
        },
        {
          "name": "GET - Agence par id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/agences/{{agenceId}}", "host": ["{{baseUrl}}"], "path": ["api", "agences", "{{agenceId}}"] } }
        },
        {
          "name": "PUT - Modifier agence",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"AutoLoc Monastir Marina\",\n  \"ville\": \"Monastir\",\n  \"adresse\": \"Port de plaisance\",\n  \"telephone\": \"73999888\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/agences/{{agenceId}}", "host": ["{{baseUrl}}"], "path": ["api", "agences", "{{agenceId}}"] }
          }
        },
        {
          "name": "POST - Agence invalide (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"\",\n  \"ville\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/agences", "host": ["{{baseUrl}}"], "path": ["api", "agences"] }
          }
        }
      ]
    },
    {
      "name": "Vehicules",
      "item": [
        {
          "name": "POST - Creer vehicule",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('vehiculeId', pm.response.json().idVehicule);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"230 TUN 9999\",\n  \"marque\": \"Peugeot\",\n  \"modele\": \"2008\",\n  \"categorie\": \"SUV\",\n  \"tarifJournalier\": 120.00,\n  \"statut\": \"DISPONIBLE\",\n  \"agence\": { \"idAgence\": {{agenceId}} }\n}" },
            "url": { "raw": "{{baseUrl}}/api/vehicules", "host": ["{{baseUrl}}"], "path": ["api", "vehicules"] }
          }
        },
        {
          "name": "GET - Lister vehicules",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/vehicules", "host": ["{{baseUrl}}"], "path": ["api", "vehicules"] } }
        },
        {
          "name": "GET - Vehicule par id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/vehicules/{{vehiculeId}}", "host": ["{{baseUrl}}"], "path": ["api", "vehicules", "{{vehiculeId}}"] } }
        },
        {
          "name": "PUT - Modifier vehicule (+ equipement)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"230 TUN 9999\",\n  \"marque\": \"Peugeot\",\n  \"modele\": \"2008 GT\",\n  \"categorie\": \"SUV\",\n  \"tarifJournalier\": 135.00,\n  \"statut\": \"MAINTENANCE\",\n  \"agence\": { \"idAgence\": {{agenceId}} },\n  \"equipements\": [ { \"idEquipement\": {{equipementId}} } ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/vehicules/{{vehiculeId}}", "host": ["{{baseUrl}}"], "path": ["api", "vehicules", "{{vehiculeId}}"] }
          }
        },
        {
          "name": "POST - Immatriculation en double (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"230 TUN 9999\",\n  \"marque\": \"Renault\",\n  \"modele\": \"Clio\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 70.00,\n  \"statut\": \"DISPONIBLE\",\n  \"agence\": { \"idAgence\": {{agenceId}} }\n}" },
            "url": { "raw": "{{baseUrl}}/api/vehicules", "host": ["{{baseUrl}}"], "path": ["api", "vehicules"] }
          }
        },
        {
          "name": "GET - Vehicule inexistant (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/vehicules/99999", "host": ["{{baseUrl}}"], "path": ["api", "vehicules", "99999"] } }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "POST - Creer client",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('clientId', pm.response.json().idClient);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Hamdi\",\n  \"prenom\": \"Amine\",\n  \"email\": \"amine.hamdi@mail.tn\",\n  \"telephone\": \"95123456\",\n  \"numPermis\": \"P-0099999\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clients", "host": ["{{baseUrl}}"], "path": ["api", "clients"] }
          }
        },
        {
          "name": "GET - Lister clients",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/clients", "host": ["{{baseUrl}}"], "path": ["api", "clients"] } }
        },
        {
          "name": "GET - Client par id",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["api", "clients", "{{clientId}}"] } }
        },
        {
          "name": "PUT - Modifier client",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Hamdi\",\n  \"prenom\": \"Amine\",\n  \"email\": \"amine.hamdi@mail.tn\",\n  \"telephone\": \"95999999\",\n  \"numPermis\": \"P-0099999\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["api", "clients", "{{clientId}}"] }
          }
        },
        {
          "name": "POST - Email en double (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Autre\",\n  \"prenom\": \"Client\",\n  \"email\": \"amine.hamdi@mail.tn\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/clients", "host": ["{{baseUrl}}"], "path": ["api", "clients"] }
          }
        }
      ]
    },
    {
      "name": "Nettoyage (DELETE)",
      "item": [
        {
          "name": "DELETE - Client",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/clients/{{clientId}}", "host": ["{{baseUrl}}"], "path": ["api", "clients", "{{clientId}}"] } }
        },
        {
          "name": "DELETE - Vehicule",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/vehicules/{{vehiculeId}}", "host": ["{{baseUrl}}"], "path": ["api", "vehicules", "{{vehiculeId}}"] } }
        },
        {
          "name": "DELETE - Agence",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/agences/{{agenceId}}", "host": ["{{baseUrl}}"], "path": ["api", "agences", "{{agenceId}}"] } }
        }
      ]
    }
  ]
}
